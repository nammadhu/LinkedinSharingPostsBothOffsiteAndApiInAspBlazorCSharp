@page "/share"
@using System.Web
@using Microsoft.Extensions.Caching.Memory
@* @rendermode InteractiveServer if necessary *@
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<h3>Share to LinkedIn</h3>
<p>Pass the below parameters to post to Linkedin</p>
<input @bind="post.Text" placeholder="Enter text" />
<input @bind="post.TextUrl" placeholder="Enter URL" />
<br />
<input @bind="post.ImageUrlRemote" placeholder="Enter image URL" />
<br />
<input @bind="post.ReturnUrl" placeholder="Return URL" />
<br/>
<button @onclick="SharePost" targe>Share On Current Tab</button>
<br />
<a href="@GetAuthorizationUrl()" target="blank">Share On New Tab</a>
@code {
	private LinkedInPost post = new LinkedInPost();

	string GetAuthorizationUrl()
	{
		post.ClientId = Configuration["LinkedIn:ClientId"]!;
		post.RedirectUri = Configuration["LinkedIn:RedirectUri"]!;
		return post.GetAuthorizationUrl();
		//"https://www.linkedin.com/oauth/v2/authorization?response_type=code&client_id=78y4e4touu7uv8&redirect_uri=https://localhost:7244/linkedin/callback&scope=openid%20profile%20email%20r_basicprofile%20w_member_social&state=Text%3DDefaultTest%2520Of%2520Linkedin%2520Post%2520Testing%2520Text%2520Here%2520only%26ImageUrlRemote%3Dhttps%253A%252F%252Fwww.w3schools.com%252Fhowto%252Fimg_nature.jpg%26TextUrl%3DSmartTown.in%26ReturnUrl%3D%252FCounter"
	}
	private void SharePost() => Navigation.NavigateTo(GetAuthorizationUrl(), true);
}